#!/sbin/sh
# The install zip's script, run by the recovery (TWRP, OrangeFox) as: update-binary VERSION OUTFD ZIP
# The root is on its partition already (fastboot flash userdata root.img); this checks it, writes the tail area
# (settings record cleared, the phone's firmware, log cleared), keeps the Android boot in the saved area and chains
# the loader into boot, last (the chained image's size and SHA-256 recorded after it). Nothing is written until every
# check passes; each write is read back.
# A split zip (member split_size, GiB) has two passes: without xnusys it carves it off userdata's end and stops for
# fastboot flash xnusys root.img; with it, the root is on xnusys and split-chain saves and chains boot. Run again
# after iOS has run (an Android update replaced boot), the root's headers suffice and its settings and log stay.
# An uninstall zip (member uninstall) gives xnusys back to userdata and the saved boot back to boot (split-uninstall).
# Dry runs on a Mac: MAPPLE_DEVICE=spaced, MAPPLE_BLOCK=dir (files boot, userdata, xnusys), MAPPLE_DISK=file,
# MAPPLE_FW=dir (vendor/, odm/), MAPPLE_TP=file (for /proc/devinfo/tp), MAPPLE_NVDATA=dir (nvdata's files).
OUTFD=$2 ZIP=$3 D=/tmp/mapple DISK=
B=${MAPPLE_BLOCK:-/dev/block/by-name}/boot U=${MAPPLE_BLOCK:-/dev/block/by-name}/userdata
CONNSYS="soc2_2_ram_mcu_2_1_hdr.bin soc2_2_ram_wifi_2_1_hdr.bin soc2_2_ram_bt_2_1_hdr.bin
	WIFI_RAM_CODE_soc2_2_2_1.bin WMT_SOC.cfg BT_FW.cfg"

# TWRP's shell takes one-digit descriptors only in >&N (it passes OUTFD=30): through /proc where there is one
ui() {
	if [ -e "/proc/self/fd/$OUTFD" ]; then
		echo "ui_print $*" > "/proc/self/fd/$OUTFD"; echo ui_print > "/proc/self/fd/$OUTFD"
	else
		echo "ui_print $*" >&"$OUTFD"; echo ui_print >&"$OUTFD"
	fi
}
fail() { ui "Stopped: $*"; exit 1; }
# Before anything writes userdata or metadata. Without an Android lock TWRP decrypts and mounts /data (dm-N over
# userdata) and /metadata itself; with one it asks for the passcode, which may be cancelled, and /data stays
# encrypted and unmounted. Either way: what is mounted comes off, and nothing mounted may be userdata or a
# device-mapper device on it. Nothing here reads /data.
unmount_data() {
	[ -z "$MAPPLE_BLOCK" ] || return 0
	for m in /sdcard /data /metadata; do
		! grep -q " $m " /proc/mounts || umount "$m" || fail "$m is in use: nothing done"
	done
	p=$(basename "$(readlink -f "$U")")
	for d in $(awk '{print $1}' /proc/mounts); do
		b=$(basename "$(readlink -f "$d")")
		[ "$b" != "$p" ] && [ ! -e "/sys/block/$b/slaves/$p" ] || fail "userdata is still mounted ($d): nothing done"
	done
}
run() {
	"$D/mapple-install" "$@" > "$D/log" 2>&1; s=$?
	while read -r l; do ui "$l"; done < "$D/log"
	return $s
}

ui "Open Mapple for the realme 8i"
dev=${MAPPLE_DEVICE:-$(getprop ro.product.device)}
case $dev in spaced|RMX3151L1|RMX3286) ;; *) fail "this zip is for the realme 8i (spaced), not $dev" ;; esac
case $ZIP in /data/*|/sdcard/*|/storage/emulated/*) fail "the zip is on userdata: sideload it, or use an SD card or OTG" ;; esac
[ -b "$B" ] || [ -n "$MAPPLE_BLOCK" ] || fail "no $B"
[ -b "$U" ] || [ -n "$MAPPLE_BLOCK" ] || fail "no $U"

rm -rf "$D"; mkdir -p "$D/fw/connsys" "$D/fw/touch" || fail "no $D"
unzip -o -q "$ZIP" -x 'META-INF/*' -d "$D" || fail "cannot unpack the zip"
(cd "$D" && sha256sum -c SHA256SUMS >/dev/null) || fail "the zip's files do not match SHA256SUMS"
chmod 755 "$D/mapple-install"

if [ -f "$D/uninstall" ]; then
	ui "Uninstall: xnusys goes back into userdata. This formats Android's data and iOS's."
	DISK=${MAPPLE_DISK:-$(readlink -f "$U" | sed 's/[0-9]*$//')}
	unmount_data
	run split-uninstall "$DISK" "$B" || fail "not uninstalled"
	ui "Done: reboot; Android sets its data up again"
	exit 0
fi

R=$U
if [ -f "$D/split_size" ]; then
	R=${MAPPLE_BLOCK:-/dev/block/by-name}/xnusys
	DISK=${MAPPLE_DISK:-$(readlink -f "$U" | sed 's/[0-9]*$//')}
	if [ ! -e "$R" ]; then
		ui "Making xnusys ($(cat "$D/split_size") GiB) off userdata's end: Android's data is erased"
		unmount_data
		run split-carve "$DISK" --size "$(cat "$D/split_size")" || fail "xnusys was not made; the partition table is as it was"
		ui "Next: adb reboot bootloader; fastboot flash xnusys root.img; fastboot reboot recovery; then this zip again"
		exit 0
	fi
fi

[ -n "$DISK" ] || unmount_data
ui "Checking the root on ${R##*/} (a minute)"
again=
if ! "$D/mapple-install" verify-root "$D/root.ranges" "$R" > "$D/log" 2>&1; then
	# a split zip run again (after an Android update): a pass 2 completed before (the saved area has "chained") and
	# iOS has run on the root since, so its blocks are its own; the headers still say it is there. Its settings and
	# log stay, boot is chained again. A first pass 2 has no "chained" (pass 1 clears the saved area): full check.
	[ -n "$DISK" ] && "$D/mapple-install" saved "$R" chained >/dev/null 2>&1 &&
		run verify-root --headers "$D/root.ranges" "$R" || {
		while read -r l; do ui "$l"; done < "$D/log"
		fail "flash the root first: fastboot flash ${R##*/} root.img"
	}
	again=1
	ui "The root has run already: boot is chained again, iOS's settings and log are kept"
else
	while read -r l; do ui "$l"; done < "$D/log"
fi

ui "Reading the firmware from vendor and odm"
if [ -n "$MAPPLE_FW" ]; then
	V=$MAPPLE_FW/vendor O=$MAPPLE_FW/odm
else
	# through TWRP's fstab, which knows they are EROFS (a mount of the device by itself tries f2fs and exfat);
	# what TWRP has mounted already stays mounted
	V=/vendor O=/odm mounted=
	for m in /vendor /odm; do
		grep -q " $m " /proc/mounts && continue
		mount "$m" || fail "cannot mount $m"
		mounted="$mounted $m"
	done
fi
for f in $CONNSYS; do cp "$V/firmware/$f" "$D/fw/connsys/" || fail "no $f in vendor"; done
# the panel's own file, as /proc/devinfo/tp names it ("fw_path: tp/21684/FW_NF_ILI7807S_BOE.bin"); without it, the
# only one there is. mtkloader reads touch/ilifw.bin from the tail at boot.
tp=$(sed -n 's/.*fw_path:[[:space:]]*//p' "${MAPPLE_TP:-/proc/devinfo/tp}" 2>/dev/null)
if [ -n "$tp" ]; then
	t=$O/firmware/$tp
else
	t=
	for c in "$O"/firmware/tp/*/FW_NF_ILI7807S_*.bin "$O"/firmware/FW_NF_ILI7807S_*.bin; do
		[ -f "$c" ] || continue
		[ -z "$t" ] || fail "two touch firmware files in odm, and no /proc/devinfo/tp to choose"
		t=$c
	done
fi
[ -f "$t" ] || fail "no touch firmware in odm"
cp "$t" "$D/fw/touch/" || fail "cannot copy $t"
run ilifw "$t" "$D/fw/touch/ilifw.bin" || fail "the touch firmware does not convert"
[ -n "$MAPPLE_FW" ] || [ -z "$mounted" ] || umount $mounted
# the phone's Wi-Fi NVRAM (it holds the MAC): nvdata's WIFI, nvdata mounted read only; never printed
N=$D/nvdata nv=
if [ -n "$MAPPLE_NVDATA" ]; then
	nv=$MAPPLE_NVDATA/APCFG/APRDEB/WIFI
elif mkdir -p "$N" && mount -t ext4 -o ro,noload /dev/block/by-name/nvdata "$N" 2>/dev/null; then
	nv=$N/APCFG/APRDEB/WIFI
fi
if [ -n "$nv" ] && [ -f "$nv" ] && cp "$nv" "$D/fw/connsys/WIFI"; then
	chmod 600 "$D/fw/connsys/WIFI"
else
	ui "No Wi-Fi NVRAM in nvdata: Wi-Fi will need it"
fi
[ -n "$MAPPLE_NVDATA" ] || ! grep -q " $N " /proc/mounts || umount "$N"
(cd "$D/fw" && tar -cf "$D/fw.tar" connsys touch) || fail "cannot pack the firmware"

if [ -n "$DISK" ]; then
	ui "Writing"
	[ -n "$again" ] || run put "$R" settings /dev/null || fail "settings record"
	run put "$R" firmware "$D/fw.tar" || fail "firmware"
	[ -n "$again" ] || run put "$R" log /dev/null || fail "log"
	run split-chain "$DISK" "$B" "$D/mtkloader.bin" "$D/xnup.bin" || fail "boot was not chained"
	ui "Done: reboot into Open Mapple"
	exit 0
fi

cat "$B" > "$D/boot.prev" || fail "cannot read boot"
run chain "$D/boot.prev" "$D/mtkloader.bin" "$D/xnup.bin" --backup "$D/boot.orig" --out "$D/boot.new" ||
	fail "cannot chain the loader into this boot image"

ui "Writing"
run put "$U" settings /dev/null || fail "settings record"
run put "$U" firmware "$D/fw.tar" || fail "firmware"
run put "$U" log /dev/null || fail "log"
[ ! -f "$D/boot.orig" ] || run save "$U" boot "$D/boot.orig" || fail "the Android boot was not saved; boot is unchanged"
if ! run put "$B" 0 "$D/boot.new"; then
	run put "$B" 0 "$D/boot.prev" || fail "boot is broken and could not be put back: do not reboot; adb pull $D/boot.prev"
	fail "boot could not be written; it is back as it was"
fi
run save "$U" chained "$D/boot.new" || ui "boot is chained; its record in the saved area was not written"
ui "Done: reboot into Open Mapple"
